   "source": [
    "# LeetCode 1068. Product Sales Analysis I\n",
    "\n",
    "Link: https://leetcode.com/problems/product-sales-analysis-i/submissions/2144216250/?envType=study-plan-v2&envId=top-sql-50"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a45a33db",
   "metadata": {},
   "source": [
    "Solution:\n",
    "\n",
    "```sql\n",
    "SELECT product_name, year, price\n",
    "FROM Sales sal JOIN Product prod\n",
    "ON sal.product_id = prod.product_id\n",
    "```"
   ]
  }
